{
  "name": "Credito Cooperativo SC",
  "dataColors": [
    "#0B2545",
    "#E07A1F",
    "#2A9D8F",
    "#8DA9C4",
    "#C44536",
    "#6C757D",
    "#13315C",
    "#F2C14E"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2733",
  "tableAccent": "#0B2545",
  "good": "#2A9D8F",
  "bad": "#C44536",
  "neutral": "#8DA9C4",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2733"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5C6B7A"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#0B2545"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2733"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}